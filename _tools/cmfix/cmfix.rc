/* File properties of dsound.dll (Explorer > Properties > Details). */
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    CMFIX_VERSION_BIN
PRODUCTVERSION CMFIX_VERSION_BIN
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "wraith-wall"
            VALUE "FileDescription",  "CM0102 Display Fix (cmfix): display modes and crisp text for Championship Manager 01/02, loaded as a DirectSound proxy"
            VALUE "FileVersion",      CMFIX_VERSION
            VALUE "InternalName",     "cmfix"
            VALUE "LegalCopyright",   "Copyright (c) 2026 wraith-wall. MIT license."
            VALUE "OriginalFilename", "dsound.dll"
            VALUE "ProductName",      "CM0102 Display Fix"
            VALUE "ProductVersion",   CMFIX_VERSION
            VALUE "Comments",         "https://github.com/wraith-wall/CM0102-Display-Fix"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
